{
  "extends": "./tsconfig.build.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    "typeRoots": ["./node_modules/@types", "./types"],
    "resolveJsonModule": true
  },
  "include": [
    "bin.ts",
    "tsdown.config.ts",
    "vitest.config.ts",
    "src/**/*",
    "e2e-harness/**/*",
    "scripts/**/*",
    "__mocks__/**/*",
    "types/**/*",
    "e2e-tests/mocks/**/*"
  ],
  "exclude": ["node_modules", "dist", ".tsbuild"]
}
