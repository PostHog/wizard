{
  "extends": "./tsconfig.build.json",

  "compilerOptions": {
    "types": ["node"],
    "typeRoots": ["./node_modules/@types", "./types"],
    "declaration": true,
    "resolveJsonModule": true,
    "outDir": "dist"
  },
  "include": [
    "__tests__",
    "__mocks__/**/*",
    "index.ts",
    "bin.ts",
    "tsdown.config.ts",
    "vitest.config.ts",
    "spec/**/*",
    "src/**/*",
    "test/**/*",
    "e2e-harness/**/*",
    "types/**/*"
  ],
  "exclude": [
    // Layer declarations the compiler enforcement builds (tsconfig.layers.json).
    ".tsbuild/**/*"
  ],
  "ts-node": {
    "files": true
  }
}
