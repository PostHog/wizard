// program folder, which import this and never the other way.
{
  "extends": "../../tsconfig.no-tui.json",
  "include": ["shared"],
  "references": [
    { "path": "../tsconfig.json" }, { "path": "../shared" }, { "path": "../agent" },
    { "path": "../services" }, { "path": "contract" }
  ]
}
