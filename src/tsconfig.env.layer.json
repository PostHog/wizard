{
  "extends": "../tsconfig.layers.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "../.tsbuild/env",
    "tsBuildInfoFile": "../.tsbuild/env/.tsbuildinfo",
    "paths": {
      "ink": [
        "../types/boundaries/ink.d.ts"
      ],
      "ink/*": [
        "../types/boundaries/ink-subpath.d.ts"
      ],
      "react": [
        "../types/boundaries/react.d.ts"
      ],
      "react/*": [
        "../types/boundaries/react-subpath.d.ts"
      ],
      "@inkjs/ui": [
        "../types/boundaries/inkjs-ui.d.ts"
      ],
      "ink-testing-library": [
        "../types/boundaries/ink-testing-library.d.ts"
      ]
    }
  },
  "files": [
    "env.ts",
    "../types/read-env.d.ts",
    "../types/xcode.d.ts"
  ]
}
