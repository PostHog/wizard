{
  "compilerOptions": {
    "composite": true,
    "rootDir": ".",
    "outDir": ".tsbuild",
    "emitDeclarationOnly": true,
    "noEmitOnError": true,
    "stripInternal": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noFallthroughCasesInSwitch": true,
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "skipLibCheck": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "resolveJsonModule": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "typeRoots": ["./node_modules/@types", "./types"],
    "types": ["node", "read-env", "xcode", "vitest-global-types"],
    // Entries only. A layer reads another through its entry, and the layer's
    // `references` decide which projects it can reach at all.
    "paths": {
      "@env": ["./src/env.ts"],
      "@shared/*": ["./src/shared/*"],
      "@utils/*": ["./src/shared/utils/*"],
      "@host/*": ["./src/host/*"],
      "@agent": ["./src/agent/index.ts"],
      "@agent/types": ["./src/agent/types.ts"],
      "@agent/*": ["./src/agent/*"],
      "@programs": ["./src/programs/index.ts"],
      "@programs/types": ["./src/programs/types.ts"],
      "@programs/*": ["./src/programs/*"],
      "@tools": ["./src/tools/index.ts"],
      "@tui": ["./src/tui/index.ts"],
      "@tui/*": ["./src/tui/*"],
      "@headless": ["./src/headless/index.ts"],
      "@cli": ["./src/cli/index.ts"],
      "@cli/*": ["./src/cli/*"],
      "@e2e-harness/*": ["./e2e-harness/*"]
    }
  }
}
