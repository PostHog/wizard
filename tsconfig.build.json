{
  "compilerOptions": {
    "declaration": true,
    "stripInternal": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noFallthroughCasesInSwitch": true,
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "skipLibCheck": true,
    "types": [],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "sourceMap": true,
    "inlineSources": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "paths": {
      "@env": ["./src/env.ts"],
      "@shared/*": ["./src/shared/*"],
      "@agent": ["./src/agent/index.ts"],
      "@agent/types": ["./src/agent/types.ts"],
      "@agent/*": ["./src/agent/*"],
      "@programs": ["./src/programs/index.ts"],
      "@programs/types": ["./src/programs/types.ts"],
      "@programs/*": ["./src/programs/*"],
      "@tui": ["./src/tui/index.ts"],
      "@tui/types": ["./src/tui/types.ts"],
      "@tui/*": ["./src/tui/*"],
      "@headless": ["./src/headless/index.ts"],
      "@headless/types": ["./src/headless/types.ts"],
      "@headless/*": ["./src/headless/*"],
      "@cli/*": ["./src/cli/*"],
      "@e2e-harness/*": ["./e2e-harness/*"],
      "@utils/*": ["./src/shared/utils/*"]
    }
  }
}
