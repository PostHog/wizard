{
  "compilerOptions": {
    "declaration": true,
    "stripInternal": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noFallthroughCasesInSwitch": true,
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "skipLibCheck": true,
    "types": [],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "sourceMap": true,
    "inlineSources": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "paths": {
      "@env": ["./src/env.ts"],
      "@shared/*": ["./src/shared/*"],
      "@agent": ["./src/agent/index.ts"],
      "@agent/types": ["./src/agent/types.ts"],
      "@agent/*": ["./src/agent/*"],
      "@lib/*": ["./src/lib/*"],
      "@e2e-harness/*": ["./e2e-harness/*"],
      "@utils/*": ["./src/shared/utils/*"],
      "@ui": ["./src/ui/index.ts"],
      "@ui/*": ["./src/ui/*"],
      "@steps": ["./src/steps/index.ts"],
      "@steps/*": ["./src/steps/*"],
      "@frameworks/*": ["./src/frameworks/*"]
    }
  }
}
