// bin.ts, main.ts and the build and test configs. bin.ts checks the Node version
// and loads main.ts, which may import the CLI's entry and the shared layer
// (`@env`, `@shared/*`, `@utils/*`) and no other layer, which `paths` fences:
// `references` alone would let it reach everything the CLI reaches.
{
  "extends": "./tsconfig.no-tui.json",
  "compilerOptions": {
    "paths": {
      "@env": ["./src/env.ts"],
      "@shared/*": ["./src/shared/*"],
      "@utils/*": ["./src/shared/utils/*"],
      "@cli": ["./src/cli/index.ts"],
      "ink": ["./types/tui-only.fence"],
      "ink/*": ["./types/tui-only.fence"],
      "react": ["./types/tui-only.fence"],
      "react/*": ["./types/tui-only.fence"],
      "@inkjs/ui": ["./types/tui-only.fence"],
      "ink-testing-library": ["./types/tui-only.fence"]
    }
  },
  "files": ["bin.ts", "main.ts", "tsdown.config.ts", "vitest.config.ts"],
  "references": [{ "path": "./src" }, { "path": "./src/shared" }, { "path": "./src/cli" }]
}
